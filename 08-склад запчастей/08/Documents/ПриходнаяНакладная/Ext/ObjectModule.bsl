Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
    // 1. Разрешаем запись движений по регистру
    Движения.ОстаткиЗапчастей.Записывать = Истина;
    
    // 2. Обходим табличную часть "СписокЗапчастей"
    Для Каждого Строка Из СписокЗапчастей Цикл
        
        // 3. Создаем новое движение
        Движение = Движения.ОстаткиЗапчастей.Добавить();
        
        // 4. Заполняем поля движения
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Период = Дата;
        
        // ВАЖНО: Берем запчасть именно из СТРОКИ табличной части
        Движение.Запчасть = Строка.Запчасть; 
        Движение.Склад = Склад;
        Движение.Количество = Строка.Количество;
        
    КонецЦикла;
    
КонецПроцедуры