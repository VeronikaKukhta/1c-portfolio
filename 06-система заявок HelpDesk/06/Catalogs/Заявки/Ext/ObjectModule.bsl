Процедура ПередЗаписью(Отказ)
    // Если это новая заявка, статус должен быть "Новая"
    Если ЭтоНовый() Тогда
        Статус = Перечисления.СтатусыЗаявок.Новая;
        ДатаСоздания = ТекущаяДата();
    КонецЕсли;
    
    // Нельзя изменить статус на "назад"
    Если НЕ ЭтоНовый() Тогда
        СтарыйОбъект = Ссылка.ПолучитьОбъект();
        Если СтарыйОбъект.Статус = Перечисления.СтатусыЗаявок.Выполнена 
           И Статус = Перечисления.СтатусыЗаявок.Новая Тогда
            Отказ = Истина;
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "Нельзя вернуть выполненную заявку в статус 'Новая'!";
            Сообщение.Сообщить();
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры