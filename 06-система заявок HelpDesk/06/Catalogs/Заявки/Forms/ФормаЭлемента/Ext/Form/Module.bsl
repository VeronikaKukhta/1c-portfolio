&НаКлиенте
Процедура ПечатьЗаявки(Команда)
    ТабДок = СформироватьПечатнуюФорму();
    Если ТабДок <> Неопределено Тогда
        ТабДок.Показать("Заявка");
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СформироватьПечатнуюФорму()
    
    ОбъектБазы = РеквизитФормыВЗначение("Объект");
    Макет = ОбъектБазы.ПолучитьМакет("ПечатьЗаявки");
    
    // --- ЗАГОЛОВОК ---
    ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
    
    // Создаем структуру с данными. Ключи структуры = именам параметров в макете.
    ДанныеШапки = Новый Структура;
    ДанныеШапки.Вставить("Номер", ОбъектБазы.Код);
    ДанныеШапки.Вставить("Дата", Формат(ОбъектБазы.ДатаСоздания, "ДЛФ=DD"));
    
    // Заполняем. Если параметра "Номер" нет в макете, ошибки не будет.
    ОбластьЗаголовок.Параметры.Заполнить(ДанныеШапки);
    
    // --- ДАННЫЕ ---
    ОбластьДанные = Макет.ПолучитьОбласть("Данные");
    
    ДанныеСтроки = Новый Структура;
    ДанныеСтроки.Вставить("Автор", ОбъектБазы.Автор);
    ДанныеСтроки.Вставить("Исполнитель", ОбъектБазы.Исполнитель);
    ДанныеСтроки.Вставить("Описание", ОбъектБазы.Описание);
    ДанныеСтроки.Вставить("Статус", ОбъектБазы.Статус);
    
    ОбластьДанные.Параметры.Заполнить(ДанныеСтроки);
    
    // --- ВЫВОД ---
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Вывести(ОбластьЗаголовок);
    ТабДок.Вывести(ОбластьДанные);
    
    Возврат ТабДок;
    
КонецФункции