Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
    Движения.ВыполнениеПривычек.Записывать = Истина;
    
    Для Каждого Строка Из СписокПривычек Цикл
        Движение = Движения.ВыполнениеПривычек.Добавить();
		
        Движение.Период = ДатаОтметки; 
        
        Движение.Привычка = Строка.Привычка;
        Движение.Выполнено = Строка.Выполнено;
        Движение.Комментарий = Строка.Комментарий;
    КонецЦикла;
    
КонецПроцедуры