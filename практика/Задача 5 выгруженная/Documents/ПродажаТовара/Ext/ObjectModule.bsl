Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	
	Движения.Продажи.Записывать = Истина;
	Движения.Продажи.Очистить();
	
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период = Дата;   
		ДвижениеПродажи.Номенклатура = СтрокаТЧ.Номенклатура;
		ДвижениеПродажи.Количество = СтрокаТЧ.Количество;
		ДвижениеПродажи.Сумма = СтрокаТЧ.Сумма;
	КонецЦикла;
	
	
	Если НЕ Отказ Тогда
		СписатьТоварыПоПартиям(Отказ);
	КонецЕсли;
	
КонецПроцедуры   

Процедура СписатьТоварыПоПартиям(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПродажаТовараТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ПродажаТовараТовары.Количество) КАК КоличествоКПродаже
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Документ.ПродажаТовара.Товары КАК ПродажаТовараТовары
	|ГДЕ
	|	ПродажаТовараТовары.Ссылка = &ТекущийДокумент
	|СГРУППИРОВАТЬ ПО
	|	ПродажаТовараТовары.Номенклатура
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.КоличествоКПродаже КАК КоличествоКПродаже,
	|	Остатки.СрокГодности КАК СрокГодности,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК ОстатокПартии
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&МоментВремени,
	|				Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ВТ_Товары)) КАК Остатки
	|		ПО ВТ_Товары.Номенклатура = Остатки.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	СрокГодности ВОЗР
	|ИТОГИ
	|	МАКСИМУМ(КоличествоКПродаже),
	|	СУММА(ОстатокПартии)
	|ПО
	|	Номенклатура";
	
	Результат = Запрос.Выполнить();
	ВыборкаНоменклатура = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		
		
		Если ВыборкаНоменклатура.ОстатокПартии < ВыборкаНоменклатура.КоличествоКПродаже Тогда
			Нехватка = ВыборкаНоменклатура.КоличествоКПродаже - ВыборкаНоменклатура.ОстатокПартии;
			Сообщить("Недостаточно товара: " + ВыборкаНоменклатура.Номенклатура 
				+ " (нехватка: " + Нехватка + ")");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		
		ОсталосьСписать = ВыборкаНоменклатура.КоличествоКПродаже;
		ВыборкаПартии = ВыборкаНоменклатура.Выбрать();
		
		Пока ВыборкаПартии.Следующий() И ОсталосьСписать > 0 Цикл
			
			СписатьСейчас = Мин(ОсталосьСписать, ВыборкаПартии.ОстатокПартии);
			
			ДвижениеРасход = Движения.ОстаткиТоваров.Добавить();
			ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеРасход.Период = Дата; 
			ДвижениеРасход.Номенклатура = ВыборкаНоменклатура.Номенклатура;
			ДвижениеРасход.СрокГодности = ВыборкаПартии.СрокГодности;
			ДвижениеРасход.Количество = СписатьСейчас;
			
			ОсталосьСписать = ОсталосьСписать - СписатьСейчас;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры
