Функция GetList(Запрос)
    
    // 1. Получаем данные из базы
    Выборка = Справочники.Заявки.Выбрать();
    МассивЗаявок = Новый Массив;
    
    Пока Выборка.Следующий() Цикл
        СтруктураЗаявки = Новый Структура;
        СтруктураЗаявки.Вставить("Описание", Выборка.Описание);
        СтруктураЗаявки.Вставить("Статус", Выборка.Статус);
        МассивЗаявок.Добавить(СтруктураЗаявки);
    КонецЦикла;
    
    // 2. Преобразуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);
    ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
    ЗаписатьJSON(ЗаписьJSON, МассивЗаявок);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    // 3. Формируем ответ
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
    
    Возврат Ответ;
    
КонецФункции